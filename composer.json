{
    "name": "romansh/omnipay-whop",
    "type": "library",
    "description": "Whop driver for Omnipay payment processing library",
    "keywords": [
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment",
        "whop",
        "checkout",
        "purchase",
        "saas"
    ],
    "homepage": "https://github.com/romansh/omnipay-whop",
    "license": "MIT",
    "authors": [
        {
            "name": "Roman Shalabanov"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omnipay\\Whop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\Whop\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "omnipay/common": "^3.2",
        "php-http/httplug": "^2.4"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    }
}
